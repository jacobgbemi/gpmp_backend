    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (obtain token pair)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('access_token', body.access);",
                  "    pm.environment.set('refresh_token', body.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login — invalid password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"definitely-wrong\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('access_token', body.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                "refresh",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Current user (/me/)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Current user — missing token (expect 401)",
          "request": {
