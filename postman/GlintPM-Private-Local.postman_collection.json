      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "OpenAPI Schema",
